diff --git a/src/backends/native/meta-render-device.c b/src/backends/native/meta-render-device.c
index ec47cec..bfe6ada 100644
--- a/src/backends/native/meta-render-device.c
+++ b/src/backends/native/meta-render-device.c
@@ -156,6 +156,17 @@ meta_render_device_initable_init (GInitable     *initable,
                                   GError       **error)
 {
   MetaRenderDevice *render_device = META_RENDER_DEVICE (initable);
+  MetaRenderDevicePrivate *priv =
+    meta_render_device_get_instance_private (render_device);
+
+  /* Some EGL implementations retain driver handles after eglTerminate().
+   * Keep these devices usable for GBM/dumb-buffer scanout, without ever
+   * initializing their EGL implementation in the compositor process.
+   */
+  if (priv->device_file &&
+      meta_device_file_has_tag (priv->device_file,
+                                META_DEVICE_FILE_TAG_SCANOUT_ONLY, 1))
+    return TRUE;
 
   init_egl (render_device);
 
diff --git a/src/backends/native/meta-renderer-native.c b/src/backends/native/meta-renderer-native.c
index d53a298..fdaac41 100644
--- a/src/backends/native/meta-renderer-native.c
+++ b/src/backends/native/meta-renderer-native.c
@@ -205,6 +205,11 @@ meta_gbm_device_from_gpu (MetaGpuKms *gpu_kms)
   MetaRenderDevice *render_device;
   MetaRenderDeviceGbm *render_device_gbm;
 
+  /* Cursor buffers on scanout-only devices must use dumb allocations too. */
+  if (meta_kms_device_get_flags (meta_gpu_kms_get_kms_device (gpu_kms)) &
+      META_KMS_DEVICE_FLAG_SCANOUT_ONLY)
+    return NULL;
+
   renderer_gpu_data = meta_renderer_native_get_gpu_data (renderer_native,
                                                          gpu_kms);
   render_device = renderer_gpu_data->render_device;
@@ -2069,6 +2074,17 @@ create_renderer_gpu_data_gbm (MetaRendererNative *renderer_native,
   renderer_gpu_data->render_device = render_device;
   renderer_gpu_data->gpu_kms = gpu_kms;
 
+  if (meta_kms_device_get_flags (meta_gpu_kms_get_kms_device (gpu_kms)) &
+      META_KMS_DEVICE_FLAG_SCANOUT_ONLY)
+    {
+      /* Avoid even a speculative secondary GBM import/allocation. The primary
+       * GPU copies to a dumb scanout buffer, with the existing CPU fallback.
+       */
+      renderer_gpu_data->secondary.copy_mode =
+        META_SHARED_FRAMEBUFFER_COPY_MODE_PRIMARY;
+      return renderer_gpu_data;
+    }
+
   init_secondary_gpu_data (renderer_gpu_data);
   return renderer_gpu_data;
 }
