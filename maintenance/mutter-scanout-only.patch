diff --git a/src/backends/native/meta-backend-native.c b/src/backends/native/meta-backend-native.c
index 61e9278..ff1ca95 100644
--- a/src/backends/native/meta-backend-native.c
+++ b/src/backends/native/meta-backend-native.c
@@ -440,6 +440,7 @@ meta_backend_native_update_stage (MetaBackend *backend)
 static MetaRenderDevice *
 create_render_device (MetaBackendNative  *backend_native,
                       const char         *device_path,
+                      gboolean            scanout_only,
                       GError            **error)
 {
   MetaBackend *backend = META_BACKEND (backend_native);
@@ -467,6 +468,15 @@ create_render_device (MetaBackendNative  *backend_native,
   if (!device_file)
     return NULL;
 
+  if (scanout_only)
+    {
+      meta_device_file_tag (device_file, META_DEVICE_FILE_TAG_SCANOUT_ONLY, 1);
+      /* Do not try EGLStream as a fallback: it also initializes NVIDIA EGL. */
+      return META_RENDER_DEVICE (meta_render_device_gbm_new (backend,
+                                                             device_file,
+                                                             error));
+    }
+
 #ifdef HAVE_EGL_DEVICE
   if (g_strcmp0 (getenv ("MUTTER_DEBUG_FORCE_EGL_STREAM"), "1") != 0)
 #endif
@@ -546,6 +556,7 @@ add_drm_device (MetaBackendNative  *backend_native,
   g_autoptr (MetaRenderDevice) render_device = NULL;
   MetaKmsDevice *kms_device;
   MetaGpuKms *gpu_kms;
+  gboolean scanout_only;
 
   if (meta_is_udev_device_platform_device (device))
     flags |= META_KMS_DEVICE_FLAG_PLATFORM_DEVICE;
@@ -561,7 +572,26 @@ add_drm_device (MetaBackendNative  *backend_native,
 
   device_path = g_udev_device_get_device_file (device);
 
-  render_device = create_render_device (backend_native, device_path, error);
+  scanout_only =
+    g_udev_device_get_property_as_boolean (device, "MUTTER_DEVICE_SCANOUT_ONLY") ||
+    (device_path &&
+     g_strcmp0 (g_getenv ("MUTTER_DEBUG_SCANOUT_ONLY_DEVICE"), device_path) == 0);
+  if (scanout_only)
+    {
+      /* A scanout-only device cannot provide the primary EGL context. */
+      if (flags & META_KMS_DEVICE_FLAG_PREFERRED_PRIMARY)
+        {
+          g_set_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT,
+                       "A preferred primary GPU cannot be scanout-only");
+          return FALSE;
+        }
+      flags |= META_KMS_DEVICE_FLAG_SCANOUT_ONLY;
+      g_message ("Using DRM device '%s' for scanout only (no EGL or leases)",
+                 device_path);
+    }
+
+  render_device = create_render_device (backend_native, device_path,
+                                        scanout_only, error);
   if (!render_device)
     return FALSE;
 
@@ -1060,6 +1090,21 @@ meta_backend_native_get_render_device (MetaBackendNative  *backend_native,
     }
   else
     {
-      return create_render_device (backend_native, device_path, error);
+      GList *l;
+      gboolean scanout_only = FALSE;
+
+      for (l = meta_kms_get_devices (priv->kms); l; l = l->next)
+        {
+          MetaKmsDevice *kms_device = l->data;
+
+          if (g_strcmp0 (meta_kms_device_get_path (kms_device), device_path) == 0)
+            {
+              scanout_only = !!(meta_kms_device_get_flags (kms_device) &
+                                META_KMS_DEVICE_FLAG_SCANOUT_ONLY);
+              break;
+            }
+        }
+      return create_render_device (backend_native, device_path,
+                                    scanout_only, error);
     }
 }
