+  const char *path = g_udev_device_get_device_file (device);
+  GList *l;
+
+  for (l = kms->devices; path && l; l = l->next)
+    {
+      MetaKmsDevice *kms_device = l->data;
+
+      if (g_strcmp0 (path, meta_kms_device_get_path (kms_device)) == 0 &&
+          (meta_kms_device_get_flags (kms_device) &
+           META_KMS_DEVICE_FLAG_SCANOUT_ONLY))
+        {
+          MetaKmsResourceChanges changes;
+          gpointer ret;
+
+          ret = meta_kms_run_impl_task_sync (kms, remove_scanout_device_in_impl,
+                                             kms_device, NULL);
+          changes = GPOINTER_TO_UINT (ret);
+          if (changes != META_KMS_RESOURCE_CHANGE_NONE)
+            meta_kms_emit_resources_changed (kms, changes);
+          return;
+        }
+    }
+
   meta_kms_update_resources (kms, NULL, META_KMS_RESOURCE_CHANGE_NONE);
 }
 
