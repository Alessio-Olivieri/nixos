+void
+meta_kms_connector_retire_in_impl (MetaKmsConnector *connector)
+{
+  MetaKmsImpl *impl = meta_kms_impl_device_get_impl (connector->impl_device);
+
+  meta_assert_in_kms_impl (meta_kms_impl_get_kms (impl));
+
+  /* Main-thread output objects may still reference this old resource. Drop
+   * its implementation-thread work and FD hold before that final reference
+   * can disappear on another thread. Do not touch a returning kernel object. */
+  if (connector->connection_change_timeout)
+    {
+      g_source_destroy (connector->connection_change_timeout);
+      g_clear_pointer (&connector->connection_change_timeout, g_source_unref);
+    }
+  connector->connection = DRM_MODE_DISCONNECTED;
+  connector->pending_connection = DRM_MODE_DISCONNECTED;
+  meta_kms_connector_disable_in_impl (connector);
+  sync_fd_held (connector, connector->impl_device);
